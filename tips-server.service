[Unit]
Description=TIPs API Server + ngrok
After=network.target

[Service]
Type=simple
User=oaiz
WorkingDirectory=/home/oaiz/Documents/Sanora/dianexea_stack/TIPs/
# Force unbuffered stdout/stderr so every print() reaches journald live
# (under systemd stdout is a pipe, so Python block-buffers it by default and
#  logs only appear when the buffer fills — unlike a TTY which line-buffers).
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/oaiz/Documents/Sanora/dianexea_stack/TIPs/start_server.sh
Restart=on-failure
RestartSec=5
# Early reclaim pressure (gives jemalloc a chance to return pages)
MemoryHigh=11G
# Hard cap — fail this one process cleanly instead of letting the kernel
# OOM-killer damage other services on the 15 GB host.
MemoryMax=13G
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
